-- Har bill ek row hai. "data" column me rooms+items ka JSON text save hota hai.
CREATE TABLE IF NOT EXISTS BillEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    customer TEXT NOT NULL,
    phone TEXT NOT NULL,
    data TEXT NOT NULL,
    date TEXT NOT NULL,
    discount REAL NOT NULL DEFAULT 0.0,
    extraCharges REAL NOT NULL DEFAULT 0.0,
    -- Kitna paisa mila. NULL = poora paisa mil chuka (purane bills bhi isi me aate hain)
    paidAmount REAL
);

selectAll:
SELECT * FROM BillEntity ORDER BY id DESC;

selectByPhone:
SELECT * FROM BillEntity WHERE phone = ? ORDER BY id DESC;

insertBill:
INSERT INTO BillEntity(customer, phone, data, date, discount, extraCharges, paidAmount) VALUES (?, ?, ?, ?, ?, ?, ?);

lastInsertedId:
SELECT last_insert_rowid();

updateBill:
UPDATE BillEntity SET customer = ?, phone = ?, data = ?, discount = ?, extraCharges = ?, paidAmount = ? WHERE id = ?;

updatePaid:
UPDATE BillEntity SET paidAmount = ? WHERE id = ?;

deleteBill:
DELETE FROM BillEntity WHERE id = ?;

deleteAll:
DELETE FROM BillEntity;
