-- Har bill ek row hai. "data" column me rooms+items ka JSON text save hota hai.
CREATE TABLE IF NOT EXISTS BillEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    customer TEXT NOT NULL,
    phone TEXT NOT NULL,
    data TEXT NOT NULL,
    date TEXT NOT NULL,
    discount REAL NOT NULL DEFAULT 0.0,
    extraCharges REAL NOT NULL DEFAULT 0.0,
    paidAmount REAL,
  showProduct INTEGER NOT NULL DEFAULT 0,
  showCategory INTEGER NOT NULL DEFAULT 0,
  showSubcategory INTEGER NOT NULL DEFAULT 0

);

-- label = invoice number (hammad-05), InvoiceLabel table (sync.sq) se. Purane bills ka label null.
selectAll:
SELECT b.id, b.customer, b.phone, b.data, b.date, b.discount, b.extraCharges, b.paidAmount,
       b.showProduct, b.showCategory, b.showSubcategory, l.label
FROM BillEntity b LEFT JOIN InvoiceLabel l ON l.billId = b.id
ORDER BY b.id DESC;

selectByPhone:
SELECT b.id, b.customer, b.phone, b.data, b.date, b.discount, b.extraCharges, b.paidAmount,
       b.showProduct, b.showCategory, b.showSubcategory, l.label
FROM BillEntity b LEFT JOIN InvoiceLabel l ON l.billId = b.id WHERE b.phone = ? ORDER BY b.id DESC;


selectById:
SELECT b.id, b.customer, b.phone, b.data, b.date, b.discount, b.extraCharges, b.paidAmount,
       b.showProduct, b.showCategory, b.showSubcategory, l.label
FROM BillEntity b LEFT JOIN InvoiceLabel l ON l.billId = b.id WHERE b.id = ?;

insertBill:
INSERT INTO BillEntity(customer, phone, data, date, discount, extraCharges, paidAmount,showProduct,showCategory,showSubcategory) VALUES (?, ?, ?, ?, ?, ?, ?,?,?,?);

insertBillWithId:
INSERT INTO BillEntity(id, customer, phone, data, date, discount, extraCharges, paidAmount,
       showProduct, showCategory, showSubcategory) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

lastInsertedId:
SELECT last_insert_rowid();

updateBill:
UPDATE BillEntity SET customer=?, phone=?, data=?, discount=?, extraCharges=?, paidAmount=?,
       showProduct=?, showCategory=?, showSubcategory=? WHERE id = ?;

updatePaid:
UPDATE BillEntity SET paidAmount = ? WHERE id = ?;

updatePhone:
UPDATE BillEntity SET phone = ? WHERE id = ?;

deleteBill:
DELETE FROM BillEntity WHERE id = ?;

deleteAll:
DELETE FROM BillEntity;


countBills:
SELECT COUNT(*) FROM BillEntity;
