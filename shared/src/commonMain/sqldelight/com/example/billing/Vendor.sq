-- ============ VENDORS ============
CREATE TABLE IF NOT EXISTS VendorEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    address TEXT NOT NULL DEFAULT '',
    phone1 TEXT NOT NULL DEFAULT '',
    phone2 TEXT NOT NULL DEFAULT '',
    accountDescription TEXT NOT NULL DEFAULT '',
    createdAt TEXT NOT NULL
);

CREATE TABLE IF NOT EXISTS VendorPaymentEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    vendorId INTEGER NOT NULL,
    amount REAL NOT NULL,
    discount REAL NOT NULL DEFAULT 0.0,
    date TEXT NOT NULL,
    note TEXT NOT NULL DEFAULT ''
);

-- ============ 5-LEVEL HIERARCHY ============
-- Group > SubGroup > Category > SubCategory > Product
CREATE TABLE IF NOT EXISTS GroupEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL COLLATE NOCASE UNIQUE
);

CREATE TABLE IF NOT EXISTS SubgroupEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    groupId INTEGER,
    name TEXT NOT NULL COLLATE NOCASE
);

CREATE TABLE IF NOT EXISTS CategoryEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    subgroupId INTEGER,
    name TEXT NOT NULL COLLATE NOCASE,
    UNIQUE(subgroupId, name)
);

CREATE TABLE IF NOT EXISTS SubcategoryEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    categoryId INTEGER,
    name TEXT NOT NULL COLLATE NOCASE
);

-- ============ PRODUCTS (discountPct ADDED) ============
CREATE TABLE IF NOT EXISTS ProductEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    groupId INTEGER,
    subgroupId INTEGER,
    categoryId INTEGER,
    subcategoryId INTEGER,
    price REAL NOT NULL DEFAULT 0.0,
    salePrice REAL NOT NULL DEFAULT 0.0,
    discountPct REAL NOT NULL DEFAULT 0.0,
    openingStock REAL NOT NULL DEFAULT 0.0,
    unit TEXT NOT NULL DEFAULT 'pcs'
);

-- ============ PURCHASES ============
CREATE TABLE IF NOT EXISTS PurchaseEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    vendorId INTEGER NOT NULL,
    date TEXT NOT NULL,
    data TEXT NOT NULL,
    total REAL NOT NULL DEFAULT 0.0,
    discount REAL NOT NULL DEFAULT 0.0,
    paid REAL NOT NULL DEFAULT 0.0,
    notes TEXT NOT NULL DEFAULT ''
);

-- ============ CUSTOMER ACCOUNTS ============
CREATE TABLE IF NOT EXISTS SalesmanEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL UNIQUE,
    phone1 TEXT NOT NULL DEFAULT '',
    phone2 TEXT NOT NULL DEFAULT '',
    address TEXT NOT NULL DEFAULT '',
    accountNo TEXT NOT NULL DEFAULT ''
);

CREATE TABLE IF NOT EXISTS CustomerPaymentEntity (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    customerId INTEGER NOT NULL,
    amount REAL NOT NULL,
    discount REAL NOT NULL DEFAULT 0.0,
    date TEXT NOT NULL,
    note TEXT NOT NULL DEFAULT ''
);

-- ============ QUERIES — GROUP / SUBGROUP ============
selectAllGroups:
SELECT * FROM GroupEntity ORDER BY name COLLATE NOCASE;
selectGroupByName:
SELECT * FROM GroupEntity WHERE name = ? COLLATE NOCASE;
insertGroup:
INSERT INTO GroupEntity(name) VALUES (?);
updateGroup:
UPDATE GroupEntity SET name = ? WHERE id = ?;
deleteGroup:
DELETE FROM GroupEntity WHERE id = ?;

selectAllSubgroups:
SELECT * FROM SubgroupEntity ORDER BY name COLLATE NOCASE;
selectSubgroupsForGroup:
SELECT * FROM SubgroupEntity WHERE groupId = ? ORDER BY name COLLATE NOCASE;
selectSubgroupByName:
SELECT * FROM SubgroupEntity WHERE groupId = ? AND name = ? COLLATE NOCASE;
insertSubgroup:
INSERT INTO SubgroupEntity(groupId, name) VALUES (?, ?);
updateSubgroup:
UPDATE SubgroupEntity SET name = ? WHERE id = ?;
deleteSubgroup:
DELETE FROM SubgroupEntity WHERE id = ?;

-- ============ CATEGORY (linked to subgroup) ============
selectAllCategories:
SELECT * FROM CategoryEntity ORDER BY name COLLATE NOCASE;
selectCategoriesForSubgroup:
SELECT * FROM CategoryEntity WHERE subgroupId = ? ORDER BY name COLLATE NOCASE;
selectCategoryByName:
SELECT * FROM CategoryEntity WHERE subgroupId = ? AND name = ? COLLATE NOCASE;
insertCategory:
INSERT INTO CategoryEntity(subgroupId, name) VALUES (?, ?);
updateCategory:
UPDATE CategoryEntity SET name = ? WHERE id = ?;
deleteCategory:
DELETE FROM CategoryEntity WHERE id = ?;

-- ============ SUBCATEGORY ============
selectAllSubcategories:
SELECT * FROM SubcategoryEntity ORDER BY name COLLATE NOCASE;
selectSubcategoriesForCategory:
SELECT * FROM SubcategoryEntity WHERE categoryId = ? ORDER BY name COLLATE NOCASE;
selectSubcategoryByName:
SELECT * FROM SubcategoryEntity WHERE categoryId = ? AND name = ? COLLATE NOCASE;
insertSubcategory:
INSERT INTO SubcategoryEntity(categoryId, name) VALUES (?, ?);
updateSubcategory:
UPDATE SubcategoryEntity SET name = ? WHERE id = ?;
deleteSubcategory:
DELETE FROM SubcategoryEntity WHERE id = ?;

-- ============ PRODUCT ============
selectAllProducts:
SELECT * FROM ProductEntity ORDER BY name COLLATE NOCASE;
selectProductById:
SELECT * FROM ProductEntity WHERE id = ?;
insertProduct:
INSERT INTO ProductEntity(name, groupId, subgroupId, categoryId, subcategoryId, price, salePrice, discountPct, openingStock, unit)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
updateProduct:
UPDATE ProductEntity SET name=?, groupId=?, subgroupId=?, categoryId=?, subcategoryId=?, price=?, salePrice=?, discountPct=?, openingStock=?, unit=?
WHERE id = ?;
deleteProduct:
DELETE FROM ProductEntity WHERE id = ?;

-- ============ CUSTOMER PAYMENTS ============
selectCustomerPayments:
SELECT * FROM CustomerPaymentEntity WHERE customerId = ? ORDER BY date DESC, id DESC;
insertCustomerPayment:
INSERT INTO CustomerPaymentEntity(customerId, amount, discount, date, note) VALUES (?, ?, ?, ?, ?);
updateCustomerPayment:
UPDATE CustomerPaymentEntity SET amount=?, discount=?, date=?, note=? WHERE id = ?;
deleteCustomerPayment:
DELETE FROM CustomerPaymentEntity WHERE id = ?;

-- ============ CUSTOMERS ============
selectAllSalesmen:
SELECT * FROM SalesmanEntity ORDER BY name;
insertSalesman:
INSERT INTO SalesmanEntity(name, phone1, phone2, address, accountNo) VALUES (?, ?, ?, ?, ?);
updateSalesman:
UPDATE SalesmanEntity SET name=?, phone1=?, phone2=?, address=?, accountNo=? WHERE id=?;
deleteSalesman:
DELETE FROM SalesmanEntity WHERE id = ?;

-- ============ VENDOR QUERIES ============
selectAllVendors:
SELECT * FROM VendorEntity ORDER BY name COLLATE NOCASE;
selectVendorById:
SELECT * FROM VendorEntity WHERE id = ?;
insertVendor:
INSERT INTO VendorEntity(name, address, phone1, phone2, accountDescription, createdAt)
VALUES (?, ?, ?, ?, ?, ?);
updateVendor:
UPDATE VendorEntity SET name=?, address=?, phone1=?, phone2=?, accountDescription=? WHERE id = ?;
deleteVendor:
DELETE FROM VendorEntity WHERE id = ?;

selectVendorBalance:
SELECT
  COALESCE((SELECT SUM(total - discount - paid) FROM PurchaseEntity WHERE vendorId = ?), 0) -
  COALESCE((SELECT SUM(amount + discount) FROM VendorPaymentEntity WHERE vendorId = ?), 0) AS balance;

selectVendorPaymentTotal:
SELECT COALESCE(SUM(amount), 0) FROM VendorPaymentEntity WHERE vendorId = ?;

selectPaymentsForVendor:
SELECT * FROM VendorPaymentEntity WHERE vendorId = ? ORDER BY date DESC, id DESC;
insertVendorPayment:
INSERT INTO VendorPaymentEntity(vendorId, amount, discount, date, note) VALUES (?, ?, ?, ?, ?);
updateVendorPayment:
UPDATE VendorPaymentEntity SET amount=?, discount=?, date=?, note=? WHERE id = ?;
deleteVendorPayment:
DELETE FROM VendorPaymentEntity WHERE id = ?;

-- ============ PURCHASE QUERIES ============
selectAllPurchases:
SELECT * FROM PurchaseEntity ORDER BY date DESC, id DESC;
selectPurchasesForVendor:
SELECT * FROM PurchaseEntity WHERE vendorId = ? ORDER BY date DESC, id DESC;
selectPurchaseById:
SELECT * FROM PurchaseEntity WHERE id = ?;
insertPurchase:
INSERT INTO PurchaseEntity(vendorId, date, data, total, discount, paid, notes)
VALUES (?, ?, ?, ?, ?, ?, ?);
updatePurchase:
UPDATE PurchaseEntity SET vendorId=?, date=?, data=?, total=?, discount=?, paid=?, notes=? WHERE id = ?;
deletePurchase:
DELETE FROM PurchaseEntity WHERE id = ?;

countProducts:
SELECT COUNT(*) FROM ProductEntity;
lastInsertedId:
SELECT last_insert_rowid();

selectAllVendorsWithBalance:
SELECT v.id, v.name, v.address, v.phone1, v.phone2, v.accountDescription, v.createdAt,
  COALESCE((SELECT SUM(total - discount - paid) FROM PurchaseEntity WHERE vendorId = v.id), 0) -
  COALESCE((SELECT SUM(amount + discount) FROM VendorPaymentEntity WHERE vendorId = v.id), 0) AS balance
FROM VendorEntity v ORDER BY v.name COLLATE NOCASE;